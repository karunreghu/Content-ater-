//@version=6
indicator("Buyer vs Seller Push", shorttitle = "Push", overlay = false)

// Buyers' push  = how far buyers lifted price from the candle's low  = Close - Low
// Sellers' push = how far sellers dropped price from the candle's high = High - Close
units = input.string("Price", "Show as", options = ["Price", "% of candle range"])

rng       = high - low
buyPush   = close - low
sellPush  = high - close
asPercent = units == "% of candle range"

buyVal  = asPercent ? (rng > 0 ? 100 * buyPush  / rng : 50) : buyPush
sellVal = asPercent ? (rng > 0 ? 100 * sellPush / rng : 50) : sellPush

plot(buyVal,   "Buyers pushed up",    color = #00C853, style = plot.style_columns)
plot(-sellVal, "Sellers pushed down", color = #D50000, style = plot.style_columns)
hline(0, "Zero", color = color.gray)
