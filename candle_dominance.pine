//@version=6
indicator("Candle Dominance - Buyers vs Sellers", shorttitle = "Dominance", overlay = false, format = format.volume)

// ───────────── Inputs ─────────────
grpC = "Classification"
domThresh  = input.float(0.60, "Dominance threshold (share of range)", minval = 0.5, maxval = 1.0, step = 0.05, group = grpC, tooltip = "Buy share = (Close - Low) / (High - Low). At or above this value buyers dominate; at or below (1 - value) sellers dominate.")
strongBody = input.float(0.60, "Strong body (body / range)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpC)
weakBody   = input.float(0.30, "Small body (body / range)",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpC)

grpV = "Volume"
volLen   = input.int(20, "Average volume length", minval = 1, group = grpV)
highVolX = input.float(1.5, "High volume (x average)", minval = 1.0, step = 0.1, group = grpV)
lowVolX  = input.float(0.7, "Low volume (x average)",  minval = 0.1, step = 0.1, group = grpV)

grpD = "Display"
colorBars  = input.bool(true, "Color price bars by dominance", group = grpD)
showAbsorb = input.bool(true, "Mark absorption candles (high volume, small body)", group = grpD)
showWeak   = input.bool(true, "Mark weak moves (big body, low volume)", group = grpD)
showTable  = input.bool(true, "Show info table for the last candle", group = grpD)

// ───────────── Core calculations ─────────────
vol      = nz(volume)
rng      = high - low
bodyPct  = rng > 0 ? math.abs(close - open) / rng : 0.0
buyShare = rng > 0 ? (close - low) / rng : 0.5          // 0..1
clv      = 2 * buyShare - 1                             // -1..+1
buyVol   = vol * buyShare
sellVol  = vol - buyVol
delta    = buyVol - sellVol
avgVol   = ta.sma(vol, volLen)
rv       = avgVol > 0 ? vol / avgVol : 1.0
noVolume = ta.cum(vol) == 0

// ───────────── Classification ─────────────
isHighVol  = rv >= highVolX
isLowVol   = rv <= lowVolX
buyersDom  = buyShare >= domThresh
sellersDom = buyShare <= 1 - domThresh
strongBuy  = buyersDom  and close > open and bodyPct >= strongBody and rv >= 1.0
strongSell = sellersDom and close < open and bodyPct >= strongBody and rv >= 1.0
absorption = bodyPct <= weakBody and isHighVol
weakMove   = bodyPct >= strongBody and isLowVol

cStrongBuy  = #00C853
cBuy        = #81C784
cStrongSell = #D50000
cSell       = #E57373
cBalanced   = #9E9E9E
cAbsorb     = #FFD600

stateColor = absorption ? cAbsorb : strongBuy ? cStrongBuy : buyersDom ? cBuy : strongSell ? cStrongSell : sellersDom ? cSell : cBalanced
verdict    = noVolume ? "No volume data" : absorption ? "Absorption" : strongBuy ? "Strong buyers" : buyersDom ? "Buyers" : strongSell ? "Strong sellers" : sellersDom ? "Sellers" : "Balanced"

// ───────────── Pane plots ─────────────
plot(buyVol,   "Buy volume",  color = color.new(cStrongBuy,  isHighVol ? 0 : 50), style = plot.style_columns)
plot(-sellVol, "Sell volume", color = color.new(cStrongSell, isHighVol ? 0 : 50), style = plot.style_columns)
plot(delta,    "Net delta",   color = delta >= 0 ? color.teal : color.orange, linewidth = 2)
plot(avgVol,   "Average volume", color = color.new(color.gray, 30), linewidth = 1)
hline(0, "Zero", color = color.gray, linestyle = hline.style_dotted)

// ───────────── Price chart visuals ─────────────
barcolor(colorBars ? stateColor : na)
plotshape(showAbsorb and absorption, "Absorption", style = shape.diamond, location = location.abovebar, color = cAbsorb, size = size.tiny, force_overlay = true)
plotshape(showWeak and weakMove, "Weak move", style = shape.xcross, location = location.belowbar, color = cBalanced, size = size.tiny, force_overlay = true)

// ───────────── Info table ─────────────
var table info = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 15), border_width = 1)

f_row(int r, string k, string v, color c) =>
    table.cell(info, 0, r, k, text_color = color.silver, text_halign = text.align_left,  text_size = size.small)
    table.cell(info, 1, r, v, text_color = c,            text_halign = text.align_right, text_size = size.small)

if showTable and barstate.islast
    f_row(0, "Verdict",    verdict, stateColor)
    f_row(1, "Buy vol",    str.tostring(buyVol,  format.volume) + "  (" + str.tostring(buyShare * 100, "#.0") + "%)", cStrongBuy)
    f_row(2, "Sell vol",   str.tostring(sellVol, format.volume) + "  (" + str.tostring((1 - buyShare) * 100, "#.0") + "%)", cStrongSell)
    f_row(3, "Net delta",  str.tostring(delta,   format.volume), delta >= 0 ? color.teal : color.orange)
    f_row(4, "CLV",        str.tostring(clv, "#.00"), color.white)
    f_row(5, "Body/range", str.tostring(bodyPct * 100, "#") + "%", color.white)
    f_row(6, "Rel volume", str.tostring(rv, "#.00") + "x", isHighVol ? cAbsorb : color.white)

// ───────────── Alerts ─────────────
alertcondition(strongBuy,  "Strong buyers",  "Strong buyer dominance on {{ticker}} ({{interval}})")
alertcondition(strongSell, "Strong sellers", "Strong seller dominance on {{ticker}} ({{interval}})")
alertcondition(absorption, "Absorption",     "Absorption candle on {{ticker}} ({{interval}}): high volume, small body")
